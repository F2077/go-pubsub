root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Makefiles require literal tabs in recipe lines, so disable EditorConfig
# rewriting of indentation for them.
[Makefile]
indent_style = tab

# Markdown and JSON are space-indented in this repo; YAML uses 2 spaces.
[*.md]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2
